msgid "Cancel"
msgstr "取消"

#: src/prefs/alarmsPage.js
msgid "Alarms"
msgstr "闹钟"

#: src/prefs/alarmsPage.js
msgid "Add one or more alarms; each one can be snoozed independently"
msgstr "添加一个或多个闹钟；每个闹钟都可以单独稍后提醒"

#: src/prefs/alarmsPage.js
msgid "Every day"
msgstr "每天"

#: src/prefs/alarmsPage.js
msgid "Add New Alarm"
msgstr "添加新闹钟"

#: src/prefs/alarmsPage.js
msgid "Time"
msgstr "时间"

#: src/prefs/alarmsPage.js
msgid "Specific Date"
msgstr "指定日期"

#: src/prefs/alarmsPage.js
msgid "Ring once on a chosen date instead of every day"
msgstr "在选定日期只响铃一次，而不是每天响铃"

#: src/prefs/alarmsPage.js
msgid "Date"
msgstr "日期"

#: src/prefs/alarmsPage.js
msgid "Label"
msgstr "标签"

#: src/prefs/alarmsPage.js
msgid "Remove This Alarm"
msgstr "删除此闹钟"

#: src/prefs/alarmsPage.js
msgid "Sound & Snooze"
msgstr "声音与稍后提醒"

#: src/prefs/alarmsPage.js
msgid "Test Alarm Sound"
msgstr "测试闹钟声音"

#: src/prefs/alarmsPage.js
msgid "Play or stop the alarm sound to preview it"
msgstr "播放或停止闹钟声音以进行试听"

#: src/prefs/alarmsPage.js
msgid "Snooze Duration"
msgstr "稍后提醒时长"

#: src/prefs/alarmsPage.js
msgid "Minutes to wait before a snoozed alarm rings again"
msgstr "已稍后提醒的闹钟再次响铃前等待的分钟数"

#: src/prefs/alarmsPage.js
msgid "On-Screen Alarm Dialog"
msgstr "屏幕闹钟对话框"

#: src/prefs/alarmsPage.js
msgid ""
"Show a dialog instead of a notification when an alarm rings, so it is not "
"missed if notifications are silenced"
msgstr "闹钟响起时显示对话框而不是通知，这样即使通知被静音也不会错过"

#: src/prefs/appearancePage.js
msgid "Appearance"
msgstr "外观"

#: src/prefs/appearancePage.js
msgid "Color & Glow"
msgstr "颜色与辉光"

#: src/prefs/appearancePage.js
msgid "Pick a theme and tune how it glows"
msgstr "选择主题并调整辉光效果"

#: src/prefs/appearancePage.js
msgid "Color Theme"
msgstr "颜色主题"

#: src/prefs/appearancePage.js
msgid "Choose your preferred LCD color style"
msgstr "选择喜欢的 LCD 颜色风格"

